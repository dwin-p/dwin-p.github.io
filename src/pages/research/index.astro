---
import OverviewLayout from "../../layouts/OverviewLayout.astro";
import research from "../../data/research.json";
---
<OverviewLayout title="Research | Daniel Winfield" description="Daniel Winfield’s research in motion tracking, digital composites, computational materials, and experimental characterization at Duke and Tuskegee." path="/research/" section="research">
 <section class="overview-hero"><p class="eyebrow">Experimental & Computational Research</p><h1>Research</h1><p class="overview-intro">Understanding physical systems through measurement, fabrication, and analysis. These studies span soft robotics, polymer composites, and point defects in crystalline materials.</p></section>
 {research.map((item,index) => <section class="section research-entry" id={item.slug}>
  <figure><img src={item.image} alt={item.alt} loading="lazy" /></figure>
  <div><p class="eyebrow">{String(index+1).padStart(2,"0")} · {item.lab}</p><h2>{item.title}</h2><p class="entry-date">{item.date} · {item.status}</p><p>{item.summary}</p><dl><dt>My contributions</dt><dd>{item.contribution}</dd><dt>Explore the work</dt><dd>{item.evidence}</dd></dl><a class="button primary" href={`/research/${item.slug}/`} aria-label={`View ${item.title}`}>View research →</a></div>
 </section>)}
</OverviewLayout>
