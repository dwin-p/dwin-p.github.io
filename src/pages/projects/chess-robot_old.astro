---
const features = [
	{
		title: "Top-Down Vision System",
		description:
			"ArUco-based board detection and homography correction provide consistent, distortion-free images for downstream perception.",
	},
	{
		title: "High-Accuracy Piece Recognition",
		description:
			"Custom-trained YOLOv8 model for chess-piece detection and classification, achieving approximately 99.5% mAP@0.5 across piece classes.",
	},
	{
		title: "Intelligent Game Play",
		description:
			"Move generation uses Stockfish with legal-move enforcement through python-chess.",
	},
	{
		title: "ROS 2 Integration",
		description:
			"Modular ROS 2 components connect perception, game logic, motion planning, and hardware control.",
	},
	{
		title: "Robotic Manipulation",
		description:
			"MoveIt-based motion planning enables pick-and-place actions using a custom suction-style end effector.",
	},
	{
		title: "Full Autonomy",
		description:
			"The integrated system can complete full games against a human opponent with minimal human intervention.",
	},
];

const contributions = [
	"Trained the custom YOLOv8 model for chess-piece detection, including dataset preparation, augmentation, and performance evaluation.",
	"Collected and curated real-world images and video used for testing and validation.",
	"Produced the project demonstration media, including filming and editing the final gameplay video.",
];

const takeaways = [
	"Realized the importance of robust data pipelines for reliable real-world vision performance.",
	"Learned that hardware imperfections such as camera angle, lighting, and 3D-printed changes can directly impact software design.",
	"Gained a deeper appreciation for system-level thinking in robotics — every module affects the next.",
	"Found that integration and debugging often take more time than individual components.",
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Autonomous Chess-Playing Robot project by Daniel Winfield."
		/>
		<title>Autonomous Chess-Playing Robot | Daniel Winfield</title>
	</head>

	<body>
		<header class="site-header">
			<a class="logo" href="/">Daniel Winfield</a>

			<nav>
				<a href="/#projects">Projects</a>
				<a href="/#research">Research</a>
				<a href="/#about">About</a>
				<a href="/#contact">Contact</a>
			</nav>
		</header>

		<main>
			<!-- HERO -->
			<section class="project-hero">
				<div class="hero-copy">
					<p class="eyebrow">Robotics · Computer Vision · ROS 2</p>

					<h1>Autonomous<br />Chess-Playing Robot</h1>

					<p class="hero-intro">
						An autonomous robotic system integrating computer vision,
						game intelligence, motion planning, and robotic manipulation
						to play chess against a human opponent.
					</p>

					<div class="project-meta">
						<span>Duke University</span>
						<span>Fall 2025</span>
						<span>Five-person team</span>
					</div>
				</div>

				<div class="hero-image">
					<img
						src="/images/projects/chess-robot/chess-robot.jpg"
						alt="Autonomous chess-playing robot with chessboard"
					/>
				</div>
			</section>

			<!-- OVERVIEW -->
			<section class="section overview">
				<div class="section-label">
					<p class="eyebrow">01</p>
					<h2>Project Overview</h2>
				</div>

				<div class="overview-content">
					<p class="lead">
						This project implements an autonomous chess-playing robot
						that combines computer vision, game intelligence, and
						robotic manipulation.
					</p>

					<p>
						A top-down camera detects the chessboard using ArUco
						markers and identifies individual pieces through a
						custom-trained YOLOv8 model. The system interprets the
						game state, selects moves using the Stockfish engine,
						and executes them through ROS 2-based motion planning
						with a custom suction end effector.
					</p>

					<p>
						The completed system is capable of playing full games
						against a human opponent, requiring coordination between
						perception, decision-making, motion planning, and
						physical manipulation.
					</p>
				</div>
			</section>

			<!-- SYSTEM PIPELINE -->
			<section class="pipeline">
				<div class="pipeline-heading">
					<p class="eyebrow">02</p>
					<h2>From Vision to Physical Action</h2>
					<p>
						The project connected several independent subsystems
						into a single autonomous pipeline.
					</p>
				</div>

				<div class="pipeline-grid">
					<article>
						<span>01</span>
						<h3>Perception</h3>
						<p>
							ArUco markers locate the board and a homography
							transformation creates a consistent top-down view.
							YOLOv8 then detects and classifies the chess pieces.
						</p>
					</article>

					<article>
						<span>02</span>
						<h3>Game Intelligence</h3>
						<p>
							The detected board state is interpreted by the
							game-logic system. Legal moves are enforced through
							python-chess and move selection is handled through
							Stockfish.
						</p>
					</article>

					<article>
						<span>03</span>
						<h3>Manipulation</h3>
						<p>
							ROS 2 and MoveIt connect the game state to the
							Kinova Gen3 Lite, generating motion plans that allow
							the robot to pick up and place pieces.
						</p>
					</article>
				</div>

				<div class="pipeline-board">
					<img
						src="/images/projects/chess-robot/board.avif"
						alt="Chessboard with ArUco markers and chess pieces"
					/>
					<div>
						<p class="eyebrow">Physical System</p>
						<h3>Instrumented Chessboard</h3>
						<p>
							The board provides the physical environment for the
							vision and manipulation pipeline, while the corner
							markers provide stable reference points for board
							localization.
						</p>
					</div>
				</div>
			</section>

			<!-- GAME DEMO -->
			<section class="section demo-section">
				<div class="section-heading">
					<div>
						<p class="eyebrow">03</p>
						<h2>System Demonstration</h2>
					</div>

					<p>
						The final system brings perception, game logic, and
						robotic manipulation together in real-world gameplay.
					</p>
				</div>

				<div class="video-container">
					<div class="video-wrapper">
                    <iframe
                        src="https://www.youtube.com/embed/s_hQdPNb9EY"
                        title="Autonomous chess robot gameplay demonstration"
                        loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen
                    ></iframe>
                    </div>
				</div>

				<p class="media-note">
					Final gameplay demonstration showing the autonomous system
					operating on the physical chessboard.
				</p>
			</section>

			<!-- KEY FEATURES -->
			<section class="section features-section">
				<div class="section-heading">
					<div>
						<p class="eyebrow">04</p>
						<h2>Key Features</h2>
					</div>

					<p>
						The system combines perception, reasoning, and physical
						interaction into one robotic application.
					</p>
				</div>

				<div class="feature-grid">
					{
						features.map((feature, index) => (
							<article class="feature-card">
								<span class="feature-number">
									{String(index + 1).padStart(2, "0")}
								</span>

								<h3>{feature.title}</h3>

								<p>{feature.description}</p>
							</article>
						))
					}
				</div>
			</section>

			<!-- COMPUTER VISION -->
			<section class="section vision-section">
				<div class="section-heading">
					<div>
						<p class="eyebrow">05</p>
						<h2>Computer Vision</h2>
					</div>

					<p>
						The perception pipeline converts camera imagery into a
						structured representation of the chessboard and its pieces.
					</p>
				</div>

				<div class="vision-grid">
					<figure class="vision-main">
						<img
							src="/images/projects/chess-robot/yolo-detection.png"
							alt="YOLOv8 detection results over a chessboard"
							loading="lazy"
						/>
						<figcaption>
							<strong>YOLOv8 Piece Detection</strong>
							<span>
								Detection output showing the model identifying
								individual chess pieces on the board.
							</span>
						</figcaption>
					</figure>

					<figure>
						<img
							src="/images/projects/chess-robot/classification-confidence.jpg"
							alt="Chess-piece classification confidence results"
							loading="lazy"
						/>
						<figcaption>
							<strong>Classification Confidence</strong>
							<span>
								Example model output used to evaluate piece
								recognition performance.
							</span>
						</figcaption>
					</figure>

					<figure>
						<img
							src="/images/projects/chess-robot/confusion-matrix.png"
							alt="Confusion matrix for chess-piece detection"
							loading="lazy"
						/>
						<figcaption>
							<strong>Confusion Matrix</strong>
							<span>
								Model evaluation across the chess-piece classes.
							</span>
						</figcaption>
					</figure>
				</div>
			</section>

			<!-- MODEL RESULTS -->
			<section class="results-section">
				<div class="results-inner">
					<div class="section-heading light-heading">
						<div>
							<p class="eyebrow">06</p>
							<h2>Model Results</h2>
						</div>

						<p>
							Training and validation results illustrate the
							development of the custom piece-recognition model.
						</p>
					</div>

					<div class="results-image">
						<img
							src="/images/projects/chess-robot/results.png"
							alt="YOLOv8 training and validation results"
							loading="lazy"
						/>
					</div>
				</div>
			</section>

			<!-- ROBOTIC MANIPULATION -->
			<section class="section manipulation-section">
				<div class="section-heading">
					<div>
						<p class="eyebrow">07</p>
						<h2>Robotic Manipulation</h2>
					</div>

					<p>
						The perception and game-logic systems ultimately had to
						be translated into reliable physical motion.
					</p>
				</div>

				<div class="manipulation-grid">
                    <figure class="manipulation-image">
                        <img
                        src="/images/projects/chess-robot/end-effector.jpg"
                        alt="Custom suction-style end effector for the chess-playing robot"
                        loading="lazy"
                        />
                        <figcaption>
                        <strong>Custom End Effector</strong>
                        <span>Suction-style mechanism used to pick up and move chess pieces.</span>
                        </figcaption>
                    </figure>

                    <div class="manipulation-copy">
                        <p class="lead">
                        MoveIt-based motion planning connects the digital chess state to the
                        Kinova Gen3 Lite.
                        </p>

                        <p>
                        The robot must approach the correct square, acquire the piece, move it
                        through a collision-free path, and place it at the destination square.
                        </p>
                    </div>
                    </div>

				<div class="gif-demo">
					<div>
						<p class="eyebrow">Manipulation Demo</p>
						<h3>Pick-and-Place Action</h3>
						<p>
							The custom end effector performs the physical
							pick-and-place operation required to execute a
							chess move.
						</p>
					</div>

					<img
						src="/images/projects/chess-robot/piece-pickup.webp"
						alt="Robot picking up a chess piece"
						loading="lazy"
					/>
				</div>
			</section>

			<!-- FULL SYSTEM -->
			<section class="section setup-section">
				<div class="section-heading">
					<div>
						<p class="eyebrow">08</p>
						<h2>Full System Setup</h2>
					</div>

					<p>
						The completed setup combines the Kinova robot, chessboard,
						camera system, control hardware, and supporting equipment.
					</p>
				</div>

				<div class="setup-video">
					<video
						controls
						playsinline
						preload="metadata"
						poster="/images/projects/chess-robot/chess-robot.jpg"
					>
						<source
							src="/videos/projects/chess-robot/full-setup.mp4"
							type="video/mp4"
						/>
						Your browser does not support the video element.
					</video>
				</div>

				<p class="media-note">
					1080p walkthrough of the complete physical system setup.
				</p>
			</section>

			<!-- CONTRIBUTIONS -->
            <section class="section contributions-section">
                <div class="contributions-grid">
                    <div class="contributions-heading">
                        <div>
                            <p class="eyebrow">09</p>
                            <h2>My Contributions</h2>
                        </div>

                        <figure class="team-photo">
                            <img
                                src="/images/projects/chess-robot/team.jpg"
                                alt="Five-person team with the autonomous chess-playing robot"
                                loading="lazy"
                            />
                            <figcaption>
                                <strong>Project Team</strong>
                                <span>Five-person team behind the autonomous chess-playing robot.</span>
                            </figcaption>
                        </figure>
                    </div>

                    <div class="contributions-list">
                        {
                            contributions.map((contribution, index) => (
                                <div class="contribution">
                                    <span>
                                        {String(index + 1).padStart(2, "0")}
                                    </span>

                                    <p>{contribution}</p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </section>

			<!-- TAKEAWAYS -->
			<section class="takeaways">
				<div class="takeaways-inner">
					<div>
						<p class="eyebrow">10</p>
						<h2>Key Takeaways</h2>
					</div>

					<div class="takeaway-list">
						{
							takeaways.map((takeaway) => (
								<div class="takeaway">
									<span>→</span>
									<p>{takeaway}</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- NAVIGATION -->
			<section class="project-navigation">
				<a href="/projects/thirdeye">
					<span>Next Project</span>
					<strong>ThirdEye →</strong>
				</a>

				<a href="/#projects">
					<span>Back to</span>
					<strong>All Projects ↑</strong>
				</a>
			</section>
		</main>

		<footer>
			<p>Daniel Winfield</p>

			<div>
				<a
					href="https://github.com/dwin-p"
					target="_blank"
					rel="noreferrer"
				>
					GitHub
				</a>

				<a href="/#projects">Projects</a>
			</div>
		</footer>
	</body>
</html>

<style>
	:root {
		--ink: #251a37;
		--paper: #f7f6f2;
		--white: #ffffff;
		--muted: #68636f;
		--line: #dcd8e0;
		--mint: #bddfd6;
		--blue: #4778bd;
		--lavender: #d1b5ef;
		--dark: #17131f;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		background: var(--paper);
		color: var(--ink);
		font-family:
			Inter,
			ui-sans-serif,
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			sans-serif;
		line-height: 1.6;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	img,
	video {
		max-width: 100%;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.25rem max(5vw, 2rem);
		background: rgba(247, 246, 242, 0.94);
		border-bottom: 1px solid var(--line);
		backdrop-filter: blur(12px);
	}

	.logo {
		font-weight: 750;
		letter-spacing: -0.02em;
	}

	nav {
		display: flex;
		gap: 2rem;
		font-size: 0.95rem;
		font-weight: 600;
	}

	nav a:hover,
	footer a:hover,
	.project-navigation a:hover {
		opacity: 0.6;
	}

	main,
	footer {
		max-width: 1500px;
		margin: 0 auto;
	}

	.eyebrow {
		margin: 0 0 1rem;
		color: var(--blue);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1 {
		margin-bottom: 2rem;
		font-size: clamp(3.5rem, 6vw, 6.8rem);
		line-height: 0.94;
		letter-spacing: -0.06em;
	}

	h2 {
		margin-bottom: 0;
		font-size: clamp(2.5rem, 4vw, 4.5rem);
		line-height: 1;
		letter-spacing: -0.045em;
	}

	h3 {
		line-height: 1.15;
		letter-spacing: -0.025em;
	}

	/* HERO */

	.project-hero {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: 5rem;
		align-items: center;
		padding: 6rem max(5vw, 2rem) 7rem;
	}

	.hero-copy {
		max-width: 650px;
	}

	.hero-intro {
		max-width: 600px;
		margin-bottom: 2rem;
		color: var(--muted);
		font-size: 1.2rem;
	}

	.project-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.project-meta span {
		padding: 0.45rem 0.8rem;
		background: var(--white);
		border: 1px solid var(--line);
		border-radius: 999px;
		font-size: 0.78rem;
		font-weight: 700;
	}

	.hero-image {
		overflow: hidden;
		aspect-ratio: 4 / 3;
		border-radius: 1.75rem;
		background: var(--ink);
	}

	.hero-image img {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		object-position: center 55%;
	}

	/* GENERAL SECTIONS */

	.section {
		padding: 7rem max(5vw, 2rem);
		border-top: 1px solid var(--line);
	}

    .features-section {
        padding-bottom: 4rem;
    }

    .vision-section {
        padding-top: 5rem;
    }

	.overview {
		display: grid;
		grid-template-columns: 0.75fr 1.25fr;
		gap: 6rem;
	}

	.section-label h2 {
		max-width: 500px;
	}

	.overview-content {
		max-width: 800px;
		color: var(--muted);
		font-size: 1.08rem;
	}

	.overview-content .lead {
		color: var(--ink);
		font-size: 1.45rem;
		line-height: 1.4;
	}

	.section-heading {
		display: grid;
		grid-template-columns: 1fr 0.8fr;
		gap: 4rem;
		align-items: end;
		margin-bottom: 3rem;
	}

	.section-heading > p {
		margin-bottom: 0.25rem;
		color: var(--muted);
		font-size: 1.05rem;
	}

	/* PIPELINE */

	.pipeline {
		padding: 7rem max(5vw, 2rem);
		background: var(--ink);
		color: white;
	}

	.pipeline-heading {
		max-width: 850px;
		margin-bottom: 4rem;
	}

	.pipeline-heading .eyebrow {
		color: var(--mint);
	}

	.pipeline-heading > p:last-child {
		margin-top: 1.5rem;
		color: rgba(255, 255, 255, 0.7);
		font-size: 1.1rem;
	}

	.pipeline-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border-top: 1px solid rgba(255, 255, 255, 0.2);
		border-bottom: 1px solid rgba(255, 255, 255, 0.2);
	}

	.pipeline-grid article {
		padding: 2.5rem;
	}

	.pipeline-grid article + article {
		border-left: 1px solid rgba(255, 255, 255, 0.2);
	}

	.pipeline-grid span {
		color: var(--mint);
		font-size: 0.8rem;
		font-weight: 800;
	}

	.pipeline-grid h3 {
		margin-top: 2rem;
		font-size: 1.6rem;
	}

	.pipeline-grid p {
		color: rgba(255, 255, 255, 0.7);
	}

	.pipeline-board {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 4rem;
		align-items: center;
		margin-top: 4rem;
	}

	.pipeline-board img {
		width: 100%;
		display: block;
		border-radius: 1.25rem;
	}

	.pipeline-board h3 {
		font-size: 2rem;
	}

	.pipeline-board p:not(.eyebrow) {
		color: rgba(255, 255, 255, 0.7);
	}

	.pipeline-board .eyebrow {
		color: var(--mint);
	}

    /* VIDEOS */

    .video-container,
    .setup-video,
    .small-video {
        overflow: hidden;
        background: #111;
        border-radius: 1.5rem;
    }

    .video-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
    }

    .video-wrapper iframe {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
        display: block;
    }

    .setup-video video,
    .small-video video {
        display: block;
        width: 100%;
        margin: 0 auto;
    }
	

	.media-note,
	.video-caption {
		margin: 1rem 0 0;
		color: var(--muted);
		font-size: 0.9rem;
	}

	/* FEATURES */

	.feature-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		border-top: 1px solid var(--line);
	}

	.feature-card {
		padding: 2.5rem;
		border-bottom: 1px solid var(--line);
	}

	.feature-card:nth-child(odd) {
		border-right: 1px solid var(--line);
	}

	.feature-number {
		color: var(--blue);
		font-size: 0.8rem;
		font-weight: 800;
	}

	.feature-card h3 {
		margin: 1.5rem 0 0.75rem;
		font-size: 1.5rem;
	}

	.feature-card p {
		max-width: 650px;
		margin-bottom: 0;
		color: var(--muted);
	}

	/* COMPUTER VISION */

	.vision-grid {
		display: grid;
		grid-template-columns: 1.25fr 0.75fr;
		gap: 1.5rem;
	}

	.vision-grid figure {
		margin: 0;
		overflow: hidden;
		background: var(--white);
		border: 1px solid var(--line);
		border-radius: 1.25rem;
	}

	.vision-grid .vision-main {
		grid-row: span 2;
	}

	.vision-grid img {
		width: 100%;
		height: 300px;
		display: block;
		object-fit: cover;
	}

	.vision-grid .vision-main img {
		height: 100%;
		min-height: 650px;
		object-fit: contain;
		background: white;
	}

	.vision-grid figcaption {
