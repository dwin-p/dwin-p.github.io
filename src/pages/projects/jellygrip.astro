---
const sketches = [
    { file: "grasp-configurations.png", title: "Grasp configurations", alt: "Hand-drawn JellyGrip finger configurations for round and rectangular objects, with hinge and inflation-pad concepts", caption: "Exploring finger articulation, opening width, and contact arrangements for different object shapes.", width: 1440, height: 1122 },
    { file: "finger-concept.png", title: "Finger and pad geometry", alt: "Original sketches of finger segments, proposed materials, and inflatable contact pads", caption: "Separating the structural finger segments from the compliant pads and considering how the pads would fit within the fingers.", width: 1440, height: 1116 },
    { file: "tubing-concept.png", title: "Tubing and actuation concepts", alt: "Original JellyGrip sketches comparing internal and external tube routing along a finger", caption: "Considering tubing routes and alternative actuation approaches. Valve selection and the inflation system remained unresolved.", width: 1440, height: 1112 },
];
const components = [
    { file: "finger-assembly.png", title: "Finger subassembly", alt: "JellyGrip CAD showing a structural finger with rounded inflation-pad geometry", caption: "The finger structure and contact-pad geometry brought together in the CAD concept." },
    { file: "pad-carrier.png", title: "Inflation-pad geometry", alt: "JellyGrip CAD showing three rounded pad features on a supporting surface", caption: "Modeled geometry for the proposed contact elements. Pad materials, sealing, and inflation behavior still required development." },
    { file: "structural-frame.png", title: "Supporting frame", alt: "JellyGrip CAD showing the main supporting frame with circular plates and vertical members", caption: "The central structure used to integrate the fingers and actuation components." },
];

const contributions = [
    "Developed the gripping-finger concept, including segment geometry, articulation, and the proposed inflatable contact elements.",
    "Developed the finger concept from sketches into CAD and worked on its integration with the central gripper mechanism.",
    "Documented the design, theoretical calculations, failure analysis, and proposed manufacturing approach in the capstone report.",
];

const decisions = [
    { title: "Articulated fingers with compliant contact", text: "The finger structures provide the mechanical geometry, while proposed inflatable pads would accommodate the object's surface. The sketches explored different configurations for round and rectangular objects." },
    { title: "Central actuation mechanism", text: "A stainless-steel lead screw, brass nut, and connecting links were modeled to coordinate finger movement. Alignment and friction were considerations for future hardware development." },
    { title: "Material and fabrication choices", text: "PLA was considered for printed structural components in the analysis, while vinyl, rubber, and leather were proposed for the inflation elements. The final pad construction and fabrication process remained open for prototyping." },
    { title: "Assembly and maintenance", text: "The concept used separate structural, actuation, and gripping components. This arrangement would allow individual parts to be fabricated, assembled, and revised during prototyping." },
];

const risks = [
    { risk: "Inflatable element rupture or leakage", response: "Pressure regulation, smooth contact surfaces, reinforced seals, and pressure-decay and cycle testing." },
    { risk: "Lead-screw friction or binding", response: "Alignment checks, lubrication, and motion testing under load." },
    { risk: "Structural deformation or fatigue", response: "Load testing of printed components and evaluation of alternative materials." },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content="JellyGrip: Daniel Winfield's senior capstone work on a biomimetic robotic end effector, including gripping-finger design, CAD integration, and theoretical analysis." />
        <title>JellyGrip | Daniel Winfield</title>
    </head>
    <body id="top">
        <a class="skip-link" href="#main">Skip to content</a>
        <header class="site-header">
            <a class="logo" href="/">Daniel Winfield</a>
            <nav aria-label="Main navigation">
                <a href="/#projects">Projects</a>
                <a href="/#research">Research</a>
                <a href="/#about">About</a>
                <a href="/#contact">Contact</a>
            </nav>
        </header>
        <main id="main">
            <section class="project-hero">
                <div>
                    <p class="eyebrow">Mechanical Design · Biomimicry · Robotics</p>
                    <h1>JellyGrip</h1>
                    <p class="subtitle">Biomimetic Robotic End Effector</p>
                    <p class="hero-intro">A three-finger gripper concept inspired by jellyfish tentacles, combining articulated structures with proposed inflatable pads for adaptive object handling.</p>
                    <div class="project-meta">
                        <span>Tuskegee University</span><span>Fall 2024</span><span>Senior Capstone</span><span>Two-person team</span>
                    </div>
                    <p class="status">Completed design study · CAD and theoretical analysis</p>
                    <a class="text-link" href="#contributions">My contributions <span aria-hidden="true">↓</span></a>
                </div>
                <figure class="hero-media">
                    <a class="hero-image-link" href="/images/projects/jellygrip/assembly.png" target="_blank" rel="noreferrer" aria-label="Open full JellyGrip assembly CAD image">
                        <img src="/images/projects/jellygrip/assembly.png" alt="JellyGrip full assembly CAD with a central lead screw, supporting frame, connecting links, and three gripping fingers" width="1583" height="840" />
                    </a>
                    <figcaption><strong>Full assembly CAD</strong><span>Mechanical concept with proposed inflation-pad geometry</span></figcaption>
                </figure>
            </section>

            <section class="section split" id="overview">
                <div><p class="eyebrow">01</p><h2>The Design Challenge</h2></div>
                <div class="copy">
                    <p class="lead">How can a single end effector accommodate both fragile and irregularly shaped objects?</p>
                    <p>JellyGrip explored this question for a warehouse robot end effector. The design brief included a wiffle ball, fuel funnel, foam soccer ball, and 5 lb dumbbell, requiring different contact arrangements within one gripper concept.</p>
                    <p>The concept paired articulated finger structures with proposed inflatable pads. The work concluded with mechanical CAD and theoretical analysis, while the inflation system remained unfinished. A physical prototype was not fabricated.</p>
                    <div class="target"><strong>Design target: handle objects up to 5 lb with a safety factor of 2.</strong><span>This was a project requirement, not a measured lifting result.</span></div>
                </div>
            </section>

            <section class="section dark" id="contributions">
                <div class="section-heading"><div><p class="eyebrow">02</p><h2>My Contributions</h2></div><p>My primary responsibility was the gripping-finger design and its integration with the end effector.</p></div>
                <div class="contribution-list">
                    {contributions.map((text, index) => <div><span>{String(index + 1).padStart(2, "0")}</span><p>{text}</p></div>)}
                </div>
            </section>

            <section class="section" id="process">
                <div class="section-heading"><div><p class="eyebrow">03</p><h2>From Concept to CAD</h2></div><p>The design process connected finger behavior to the requirements of the complete assembly.</p></div>
                <div class="process-grid">
                    <article><p class="eyebrow">Sketch</p><h3>Explore the fingers</h3><p>Develop concepts for finger segments, joint motion, and inflatable contact pads.</p></article>
                    <article><p class="eyebrow">Model</p><h3>Define the geometry</h3><p>Translate the finger concept into CAD, considering mechanical constraints and connections to the gripper.</p></article>
                    <article><p class="eyebrow">Integrate</p><h3>Evaluate the assembly</h3><p>Combine the finger design with the central mechanism and review the concept through calculations and failure analysis.</p></article>
                </div>
                <p class="media-note">Original design sketches. Select an image to inspect the full drawing.</p>
                <div class="sketch-grid">
                    {sketches.map((item, index) => (
                        <figure class={index === 0 ? "main-sketch" : ""}>
                            <a href={`/images/projects/jellygrip/${item.file}`} target="_blank" rel="noreferrer" aria-label={`Open full image: ${item.title}`}>
                                <img src={`/images/projects/jellygrip/${item.file}`} alt={item.alt} width={item.width} height={item.height} loading="lazy" />
                            </a>
                            <figcaption><strong>{item.title}</strong><span>{item.caption}</span></figcaption>
                        </figure>
                    ))}
                </div>
            </section>

            <section class="section" id="design">
                <div class="section-heading"><div><p class="eyebrow">04</p><h2>Design Decisions</h2></div><p>The system concept brought together compliant contact, mechanical actuation, and a proposed fabrication approach.</p></div>
                <div class="decision-grid">{decisions.map((item) => <article><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
                <div class="cad-grid">
                    {components.map((item) => (
                        <figure>
                            <a href={`/images/projects/jellygrip/${item.file}`} target="_blank" rel="noreferrer" aria-label={`Open full image: ${item.title}`}>
                                <img src={`/images/projects/jellygrip/${item.file}`} alt={item.alt} width="1583" height="840" loading="lazy" />
                            </a>
                            <figcaption><strong>{item.title}</strong><span>{item.caption}</span></figcaption>
                        </figure>
                    ))}
                </div>
            </section>

            <section class="section split" id="analysis">
                <div><p class="eyebrow">05</p><h2>Analysis &amp; Failure Planning</h2></div>
                <div class="copy">
                    <p class="lead">The analysis established assumptions and identified what a future prototype would need to verify.</p>
                    <p>The report considered gripping force, inflation pressure, lead-screw torque, assembly weight, and prototype cost. These were theoretical estimates; actual contact forces, actuator behavior, and repeated-use performance require hardware measurements.</p>
                    <h3>Failure Mode and Effects Analysis</h3>
                    <div class="risk-list">{risks.map((item) => <article><h4>{item.risk}</h4><p>{item.response}</p></article>)}</div>
                </div>
            </section>

            <section class="section dark split" id="outcome">
                <div><p class="eyebrow">06</p><h2>Outcome &amp; Next Steps</h2></div>
                <div class="copy">
                    <p class="lead">A documented mechanical concept with a path toward physical testing.</p>
                    <p>The team completed the mechanical CAD design and supporting theoretical analysis. The proposed inflation elements still needed material selection, sealing, valve design, and physical evaluation.</p>
                    <p>The next development step would be a single-finger prototype to measure joint motion, pad inflation, leakage, and contact behavior. Full assembly testing would then evaluate actuation, grasp retention, and repeated loading.</p>
                    <h3>Engineering Takeaway</h3>
                    <p>The finger design and its actuation mechanism must be developed together. CAD establishes geometry and integration, while physical testing is needed to determine whether the intended compliant behavior produces a reliable grasp.</p>
                </div>
            </section>
            <section class="project-navigation" aria-label="More projects">
                <a href="/projects/advanced-materials/"><span>Explore another project</span><strong>Advanced Materials Laboratory →</strong></a>
                <a href="/#projects"><span>Back to</span><strong>All Projects ↑</strong></a>
            </section>
        </main>
        <footer><p>Daniel Winfield</p><div><a href="mailto:dwinfield284@gmail.com">Email</a><a href="https://www.linkedin.com/in/daniel-b-winfield/" target="_blank" rel="noreferrer">LinkedIn</a><a href="https://github.com/dwin-p" target="_blank" rel="noreferrer">GitHub</a></div></footer>
    </body>
</html>

