---
import OverviewLayout from "../layouts/OverviewLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import projects from "../data/projects.json";
import research from "../data/research.json";
const highlights = [...projects.featured.slice(0,3), projects.current[1]];
---
<OverviewLayout title="Daniel Winfield | Engineering Portfolio" description="Daniel Winfield’s engineering portfolio: mechanical design, robotics, embedded systems, and experimental research at Duke University." path="/">
<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">Mechanical Engineering M.S. · Duke University</p>

					<h1>
						Engineering at the intersection of{" "}
						<span>robotics, hardware, and experimentation.</span>
					</h1>

					<p class="hero-description">
						I’m Daniel Winfield, a mechanical engineering graduate student
						working across robotics, mechatronics, embedded systems, computer
						vision, mechanical design, and experimental R&D.
					</p>

					<div class="hero-actions">
						<a class="button primary" href="/projects/">View Projects</a>
						<a
							class="button secondary"
							href="https://github.com/dwin-p"
							target="_blank"
							rel="noreferrer"
						>
							GitHub
						</a>
						<a
							class="button secondary"
							href="/documents/Daniel_Winfield_CV.pdf"
							target="_blank"
							rel="noopener noreferrer"
							>
							View CV (PDF)
							</a>
					</div>
				</div>

				<div class="hero-visual" aria-hidden="true">
					<div class="visual-card">
						<img src="/images/engineering-geometry.svg" alt="" width="700" height="830" decoding="async" />
					</div>
				</div>
			</section>
 <section class="section" id="projects">
  <div class="section-heading"><div><p class="eyebrow">Selected Work</p><h2>Featured Projects</h2></div><p>From autonomous systems to mechanical concepts: a selection of my work in design, integration, and testing.</p></div>
  <div class="project-grid">{highlights.map(project => <ProjectCard project={project} />)}</div>
  <div class="section-actions"><a class="button primary" href="/projects/">Explore all projects →</a><a class="button" href="/projects/#current-projects" id="current-projects">Current projects →</a></div>
 </section>
 <section class="section research research-preview" id="research">
  <div><p class="eyebrow">Research</p><h2>Experiments, measurement, and materials.</h2><p>My research spans soft robotic motion, digital composites, and the mechanical and electronic behavior of materials.</p><a class="button" href="/research/">Explore research →</a></div>
  <div class="research-preview-links">{research.map(item => <a href={`/research/${item.slug}/`}>{item.title} <span aria-hidden="true">→</span></a>)}</div>
 </section>
 <section class="section about" id="about">
  <div><p class="eyebrow">About</p><h2>Designing, building, and testing physical systems.</h2></div>
  <div class="about-copy"><p>I’m a mechanical engineering graduate student at Duke University and a Tuskegee University graduate. I enjoy turning ideas into working hardware through CAD, prototyping, sensor integration, and hands-on testing.</p><a class="project-link" href="/about/">More about me <span aria-hidden="true">→</span></a></div>
 </section>
</OverviewLayout>
