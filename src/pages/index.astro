---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHead from "../components/SiteHead.astro";
const featuredProjects = [
    {
        title: "Autonomous Chess-Playing Robot",
        slug: "chess-robot",
        date: "Fall 2025",
        published: true,
        description:
            "Autonomous robotic chess system integrating computer vision, game intelligence, ROS 2 motion planning, and a Kinova Gen3 Lite.",
        tags: ["Robotics", "Computer Vision", "ROS 2"],
        image: "/images/projects/chess-robot/chess-robot.jpg",
    },
    {
        title: "PEBBLE – Intelligent Study Companion",
        slug: "pebble",
        date: "Spring 2026",
        published: true,
        description:
            "Individually designed and built a Raspberry Pi study companion, integrating a sensor-driven timer, voice interaction, physical controls, and enclosure CAD.",
        tags: ["Embedded Systems", "Python", "Enclosure CAD"],
        image: "/images/projects/pebble/bench-prototype.jpg",
    },
    {
        title: "JellyGrip – Biomimetic End Effector",
        slug: "jellygrip",
        date: "Fall 2024",
        published: true,
        description:
            "Senior capstone design exploring three-finger adaptive gripping through finger design, CAD integration, and theoretical analysis.",
        tags: ["Mechanical Design", "CAD", "Biomimicry"],
        image: "/images/projects/jellygrip/assembly.png",
    },
    {
        title: "ThirdEye",
        slug: "thirdeye",
        date: "Fall 2025",
        published: true,
        description:
            "Team-developed eyelid measurement prototype, with my work focused on DeepLabV3 segmentation and a Raspberry Pi Android testing device.",
        tags: ["Computer Vision", "PyTorch", "Raspberry Pi"],
        image: "https://sites.duke.edu/memscapstone/files/2025/11/ThirdEye-Logo-300x165.png",
    },
    {
        title: "Survive It – Interactive Survival Game",
        slug: "surviveit",
        date: "Spring 2026",
        published: true,
        description:
            "Group-built Raspberry Pi game combining sensors, narrated choices, displays, physical controls, and servo flags, with my work focused on hardware integration and assembly.",
        tags: ["Embedded Systems", "Hardware Integration", "Python"],
        image: "/images/projects/surviveit/home-screen.png",
    },
    {
        title: "Advanced Materials Laboratory",
        slug: "advanced-materials",
        date: "Spring 2024",
        published: true,
        description:
            "Polymer specimen fabrication and materials testing, spanning mechanical response, thermal analysis, microscopy, and experimental planning.",
        tags: ["Materials Testing", "3D Printing", "Data Analysis"],
        image: "/images/projects/advanced-materials/tensile-machine.jpg",
    },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Engineering portfolio of Daniel Winfield, Mechanical Engineering M.S. student at Duke University."
		/>
		<title>Daniel Winfield | Engineering Portfolio</title>
	<SiteHead title={"Daniel Winfield | Engineering Portfolio"} description={"Engineering portfolio of Daniel Winfield, Mechanical Engineering M.S. student at Duke University."} path={"/"} />
</head>

	<body id="top">
        <a class="skip-link" href="#main">Skip to content</a>
		<SiteHeader />

		<main id="main">
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">Mechanical Engineering M.S. · Duke University</p>

					<h1>
						Engineering at the intersection of{" "}
						<span>robotics, hardware, and experimentation.</span>
					</h1>

					<p class="hero-description">
						I’m Daniel Winfield, a mechanical engineering graduate student
						working across robotics, mechatronics, embedded systems, computer
						vision, mechanical design, and experimental R&D.
					</p>

					<div class="hero-actions">
						<a class="button primary" href="#projects">View Projects</a>
						<a
							class="button secondary"
							href="https://github.com/dwin-p"
							target="_blank"
							rel="noreferrer"
						>
							GitHub
						</a>
						<a
							class="button secondary"
							href="/documents/Daniel_Winfield_CV.pdf"
							target="_blank"
							rel="noopener noreferrer"
							>
							View CV (PDF)
							</a>
					</div>
				</div>

				<div class="hero-visual" aria-hidden="true">
					<div class="visual-card">
						<img src="/images/engineering-geometry.svg" alt="" width="700" height="830" decoding="async" />
					</div>
				</div>
			</section>

			<section class="section" id="projects">
				<div class="section-heading">
					<div>
						<p class="eyebrow">Selected Work</p>
						<h2>Featured Projects</h2>
					</div>

					<p>
						Projects spanning robotics, computer vision, embedded systems,
						mechanical design, and materials testing.
					</p>
				</div>

				<div class="project-grid">
					{
						featuredProjects.map((project, index) => (
							<article class="project-card">
								<div class={`project-image project-image-${project.slug}`}>
									{
										project.image ? (
											<img
												src={project.image}
												alt={`${project.title} project`}
                                                class={`project-thumbnail ${project.slug === "thirdeye" ? "thirdeye-image" : project.slug === "jellygrip" ? "jellygrip-image" : project.slug === "advanced-materials" ? "materials-image" : project.slug === "pebble" ? "pebble-image" : project.slug === "surviveit" ? "surviveit-image" : ""}`}
												loading="lazy"
											/>
										) : null
									}

									{
										!project.image && (
											<span>{String(index + 1).padStart(2, "0")}</span>
										)
									}
								</div>

								<div class="project-content">
									<p class="project-date">{project.date}</p>
									<h3>{project.title}</h3>
									<p>{project.description}</p>

									<div class="tags">
										{project.tags.map((tag) => <span>{tag}</span>)}
									</div>

                                    {project.published ? (
                                        <a href={`/projects/${project.slug}/`} class="project-link">
                                            View project <span aria-hidden="true">→</span>
                                        </a>
                                    ) : (
                                        <p class="project-status">Case study in preparation</p>
                                    )}
								</div>
							</article>
						))
					}
				</div>
			</section>

            <section class="section" id="current-projects"><div class="section-heading"><div><p class="eyebrow">In Progress · Fall 2026</p><h2>Current Projects</h2></div><p>Ongoing mechanical design and experimental development, with completed steps distinguished from planned testing.</p></div><div class="project-grid current-grid">
<article class="project-card"><div class="project-content"><p class="project-date">Fall 2026 – Present · In progress</p><h3>Continuum Manipulator</h3><p>Developing a single-section, three-tendon manipulator and an evaluation approach for load-dependent lifting behavior.</p><a class="project-link" href="/projects/continuum-manipulator/">View progress <span aria-hidden="true">→</span></a></div></article>
<article class="project-card"><div class="current-cad"><img src="/images/projects/gripper-wrist/01_three_finger_prototype.png" alt="Design-stage CAD of the compliant gripper and wrist" width="1500" height="1100" loading="lazy" /></div><div class="project-content"><p class="project-date">Fall 2026 – Present · Prototype CAD</p><h3>Compliant Gripper &amp; Wrist</h3><p>Iterating servo linkages, finger supports, and wrist/encoder interfaces around measured hardware.</p><a class="project-link" href="/projects/gripper-wrist/">View progress <span aria-hidden="true">→</span></a></div></article>
<article class="project-card"><div class="project-content"><p class="project-date">August 2026 – Present · In progress</p><h3>Y-Zipper Mechanism</h3><p>Evaluating printed flexible-to-rigid strips and exploring packaging and actuation for a compact retractable mechanism.</p><a class="project-link" href="/projects/y-zipper/">View progress <span aria-hidden="true">→</span></a></div></article>
</div></section>
			<section class="research section" id="research">
				<div class="research-intro">
					<p class="eyebrow">Research</p>
					<h2>Experimental and computational engineering research.</h2>
				</div>

				<div class="research-grid">
					<article>
						<p class="research-number">01</p>
						<h3>Motion Tracking &amp; Thermal Studies</h3>
						<p class="research-meta">Ni Lab, Duke University · 2026–Present · Ongoing</p>
						<p>
							2D tracking, stereo reconstruction, and fabrication of cavity-size variants for digital-composite heating studies.
						</p>
						<a class="research-link" href="/research/thermal-diffusion/">View research <span aria-hidden="true">→</span></a>
					</article>

					<article>
						<p class="research-number">02</p>
						<h3>Computational Materials for Quantum Technologies</h3>
						<p class="research-meta">Tuskegee University · 2024–2025 · APS presentation</p>
						<p>
							First-principles investigation of point defects in cubic BeS
							using DFT, GW, and BSE methods to study electronic structure,
							stability, and optical excitations.
						</p>
						<a class="research-link" href="/research/bes-defects/">View research <span aria-hidden="true">→</span></a>
					</article>
					<article>
						<p class="research-number">03</p>
						<h3>Hybrid Fiber-Reinforced Polymer Composites</h3>
						<p class="research-meta">Tuskegee University · Spring 2023</p>
						<p>Fabrication and characterization of jute, E-glass, and hybrid epoxy
							composites through tensile, flexural, and dynamic mechanical testing.</p>
						<a class="research-link" href="/research/hybrid-composites/">View research <span aria-hidden="true">→</span></a>
					</article>
				</div>
			</section>

			<section class="about section" id="about">
				<div>
					<p class="eyebrow">About</p>
					<h2>Designing, building, and testing physical systems.</h2>
				</div>

				<div class="about-copy">
					<p>
						I’m pursuing an M.S. in Mechanical Engineering and Materials Science
						at Duke University after earning my B.S. in Mechanical Engineering
						from Tuskegee University. My projects and research bring together
						mechanical design, robotics, embedded systems, computer vision,
						and experimental testing.
					</p>

					<p>
						The work I enjoy most involves building and improving physical
						systems: developing CAD models, integrating sensors and electronics,
						assembling prototypes, and testing how they perform. I’m interested
						in robotics, mechatronics, and product development roles that combine
						mechanical design with hands-on hardware work.
					</p>
				</div>
			</section>
		</main>

		<SiteFooter />
	</body>
</html>

<style>

:root {
		--ink: #251a37;
		--paper: #f7f6f2;
		--white: #ffffff;
		--muted: #68636f;
		--line: #dcd8e0;
		--mint: #bddfd6;
		--coral: #e9654c;
		--blue: #4778bd;
		--lavender: #d1b5ef;
	}

* {
		box-sizing: border-box;
	}

html {
		scroll-behavior: smooth;
        scroll-padding-top: 7rem;
	}

body {
		margin: 0;
		background: var(--paper);
		color: var(--ink);
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
			"Segoe UI", sans-serif;
		line-height: 1.6;
	}

a {
		color: inherit;
		text-decoration: none;
	}

a:focus-visible { outline: 3px solid var(--blue); outline-offset: 5px; }

.skip-link { position: fixed; top: -100px; left: 1rem; z-index: 200; padding: .75rem 1rem; background: var(--white); }

.skip-link:focus { top: 1rem; }

.project-status { margin: 0; color: var(--muted); font-size: .85rem; }





main {
		max-width: 1500px;
		margin: 0 auto;
	}

.hero {
		min-height: 74vh;
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		align-items: center;
		gap: clamp(2.5rem, 4vw, 5rem);
		padding: 5.5rem max(5vw, 2rem);
	}

.eyebrow {
		margin: 0 0 1.25rem;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--blue);
	}

h1, h2, h3, p {
		margin-top: 0;
	}

h1 {
		overflow-wrap: normal;
		word-break: normal;
		hyphens: none;
		max-width: 850px;
		margin-bottom: 2rem;
		font-size: clamp(2.75rem, 4.2vw, 4.7rem);
		line-height: 0.98;
		letter-spacing: -0.055em;
	}

h1 span {
		color: var(--blue);
	}

.hero-description {
		max-width: 720px;
		margin-bottom: 2.5rem;
		font-size: clamp(1.05rem, 1.4vw, 1.3rem);
		color: var(--muted);
	}

.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

.button.primary {
		background: var(--ink);
		color: var(--white);
	}

.button.secondary:hover {
		background: var(--ink);
		color: var(--white);
	}

.hero-visual {
		display: flex;
		justify-content: center;
	}

.visual-card {
		position: relative;
		width: min(100%, 590px);
		aspect-ratio: 700 / 830;
		overflow: hidden;
		background: var(--ink);
		border-radius: 2rem;
	}

.visual-card img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center;
	}
/* Older CSS generated decorative shapes that cover the illustration. */
.visual-card::before, .visual-card::after {
		content: none !important;
		display: none !important;
	}

.section {
		padding: 7rem max(5vw, 2rem);
		border-top: 1px solid var(--line);
	}

.section-heading {
		display: grid;
		grid-template-columns: 1fr 0.8fr;
		gap: 4rem;
		align-items: end;
		margin-bottom: 3rem;
	}

h2 {
		margin-bottom: 0;
		font-size: var(--heading-section-size);
		line-height: 1.05;
		letter-spacing: -0.04em;
	}

.section-heading > p {
		margin-bottom: 0.5rem;
		color: var(--muted);
		font-size: 1.05rem;
	}

.project-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
	}

.project-card {
		overflow: hidden;
		background: var(--white);
		border: 1px solid var(--line);
		border-radius: 1.35rem;
	}

.project-image {
		position: relative;
		display: flex;
		align-items: flex-end;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		padding: 0;
		font-size: 4rem;
		font-weight: 800;
		letter-spacing: -0.05em;
	}

.project-image img {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		object-position: center 60%;
	}

.project-image > span {
		position: absolute;
		left: 1.5rem;
		bottom: 1.5rem;
		z-index: 2;
	}

.project-image > span {
		position: relative;
		z-index: 2;
	}

.project-image .image-number {
		padding: 0.15rem 0.55rem;
		border-radius: 0.4rem;
		background: rgba(37, 26, 55, 0.78);
		color: white;
		font-size: 1.2rem;
		letter-spacing: 0;
	}

.project-image img.thirdeye-image {
		inset: 0;
		width: min(70%, 300px);
		height: auto;
		max-height: 75%;
		margin: auto;
		object-fit: contain;
		object-position: center;
	}

.project-image img.jellygrip-image {
        object-fit: contain;
        object-position: center;
        transform: none;
        background: var(--white);
    }

.project-image img.materials-image {
        object-position: center 45%;
        transform: none;
    }

.project-image img.pebble-image {
        object-fit: cover;
        object-position: center;
        transform: none;
        background: #242629;
    }

.project-image-chess-robot {
		background: var(--blue);
		color: white;
	}

.project-image-jellygrip {
		background: var(--mint);
	}

.project-image-advanced-materials {
		background: var(--lavender);
	}

.project-image-pebble { background: var(--lavender); }

.project-image-thirdeye { background: var(--white); }

.project-image-surviveit { background: var(--paper); }

.project-image img.surviveit-image { object-fit: contain; object-position: center; }

.project-content {
		padding: 1.6rem;
	}

.project-date {
		margin: 0 0 0.6rem;
		font-size: 0.8rem;
		font-weight: 650;
		letter-spacing: 0.02em;
	}

.project-content h3 {
		margin-bottom: 0.75rem;
		font-size: 1.4rem;
		line-height: 1.15;
	}

.project-content > p {
		color: var(--muted);
	}

.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin: 1.3rem 0;
	}

.tags span {
		padding: 0.35rem 0.7rem;
		background: var(--paper);
		border-radius: 999px;
		font-size: 0.75rem;
		font-weight: 700;
	}

.project-link {
		display: inline-flex;
		gap: 0.5rem;
		align-items: center;
		font-weight: 750;
	}

.project-link:hover span {
		transform: translateX(4px);
	}

.project-link span {
		transition: 160ms ease;
	}

.research {
		background: var(--ink);
		color: white;
	}

.research .eyebrow {
		color: var(--mint);
	}

.research-intro {
		max-width: 900px;
		margin-bottom: 4rem;
	}

.research-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-top: 1px solid rgba(255, 255, 255, 0.2);
	}

.research-grid article {
		padding: 2rem 1.75rem;
		display: flex;
		flex-direction: column;
		border-bottom: 1px solid rgba(255, 255, 255, 0.2);
	}

.research-grid article:not(:last-child) {
		border-right: 1px solid rgba(255, 255, 255, 0.2);
	}

.research-number {
		color: var(--mint);
		font-size: 0.8rem;
		font-weight: 800;
	}

.research-grid h3 {
		font-size: 1.5rem;
	}

.research-grid article > p:not(.research-number) {
		color: rgba(255, 255, 255, 0.72);
	}

.research-grid .research-meta { font-size: .8rem; }

.research-link { color: var(--mint); font-weight: 750; margin-top: auto; padding-top: .8rem; }

.research-link:hover { text-decoration: underline; text-underline-offset: .3em; }

.research-link:focus-visible { outline: 3px solid var(--mint); outline-offset: 5px; }
	@media (max-width: 1100px) {

.research-grid { grid-template-columns: minmax(0, 1fr); }

.research-grid article { padding: 2rem 0; }

.research-grid article:not(:last-child) { border-right: 0; }

.research-grid article > p { max-width: 80ch; }
	}

.about {
		display: grid;
		grid-template-columns: 1fr 0.8fr;
		gap: 6rem;
	}

.about-copy {
		font-size: 1.15rem;
		color: var(--muted);
	}



	@media (max-width: 1050px) {


.hero {
			grid-template-columns: 1fr;
			gap: 3rem;
			padding-top: 4rem;
		}

.visual-card {
			max-width: 480px;
			aspect-ratio: 700 / 830;
		}

.visual-card img {
			object-fit: contain;
		object-position: center;
		}

.project-grid, .research-grid, .section-heading, .about {
			grid-template-columns: 1fr;
		}

.research-grid article:first-child {
			border-right: 0;
		}

.section-heading, .about {
			gap: 2rem;
		}
	}

	@media (max-width: 650px) {



.hero, .section {
			padding-left: 1.3rem;
			padding-right: 1.3rem;
		}

h1 {
			font-size: clamp(2.25rem, 8vw, 3rem);
		}

.visual-card { max-width: 420px; }

	}
    @media (prefers-reduced-motion: reduce) {

html { scroll-behavior: auto; } }

.current-grid { grid-template-columns: repeat(3,minmax(0,1fr)); align-items: stretch; }

.current-grid .project-card { display: flex; flex-direction: column; }

.current-grid .project-content { display: flex; flex-direction: column; flex: 1; }

.current-grid .project-link { margin-top: auto; padding-top: 1rem; }

.current-cad img { width: 100%; height: 170px; object-fit: contain; background: #f5f7fa; display: block; }
@media(max-width:1000px) {

.current-grid { grid-template-columns: minmax(0,1fr); }

.current-cad img { height: 240px; } }
</style>
