---
interface Props {
 project: { title: string; slug: string; date: string; description: string; tags: string[]; image?: string; status?: string; };
}
const { project } = Astro.props;
const imageClasses: Record<string, string> = { thirdeye: "thirdeye-image", jellygrip: "jellygrip-image", "advanced-materials": "materials-image", pebble: "pebble-image", surviveit: "surviveit-image", "gripper-wrist": "cad-image" };
const imageClass = imageClasses[project.slug] ?? "";
---
<article class="project-card">
 {project.image && <div class={`project-image project-image-${project.slug}`}>
  <img src={project.image} alt={`${project.title} project`} class={imageClass} loading="lazy" />
 </div>}
 <div class="project-content">
  <p class="project-date">{project.date}{project.status && <span> · {project.status}</span>}</p>
  <h3>{project.title}</h3><p>{project.description}</p>
  <div class="tags">{project.tags.map(tag => <span>{tag}</span>)}</div>
  <a href={`/projects/${project.slug}/`} class="project-link" aria-label={`View ${project.title}`}>{project.status ? "View progress" : "View project"} <span aria-hidden="true">→</span></a>
 </div>
</article>
